{
  "rules": {
    ".read": false,
    ".write": false,

    "meta": {
      "ownerAssigned": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.val() === true"
      }
    },

    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm')",

      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists()",

        "name":        { ".write": "auth != null && auth.uid === $uid && !data.exists()" },
        "email":       { ".write": "auth != null && auth.uid === $uid" },
        "avatarIndex": { ".write": "auth != null && auth.uid === $uid" },
        "vrmId":       { ".write": "auth != null && auth.uid === $uid" },
        "activeRoom":  { ".write": "auth != null && auth.uid === $uid" },
        "gangId":      { ".write": "auth != null && auth.uid === $uid" },

        "isNew": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod' || root.child('users').child(auth.uid).child('role').val() === 'mentor_senior' || root.child('users').child(auth.uid).child('role').val() === 'mentor')"
        },

        "role": {
          ".write": "auth != null",
          ".validate": "newData.val() === 'player' || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm'"
        },

        "level": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev')",
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || (newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= 10)"
        },

        "totalPlaySeconds": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 3600"
        },

        "chatMessageCount": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1"
        }
      }
    },

    "rooms": {
      ".read": "auth != null",
      "$roomId": {
        "meta": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm')"
        },
        "players": {
          "$pid": {
            ".write": "auth != null && auth.uid === $pid && (!newData.exists() || ((!root.child('users').child(auth.uid).child('jailedUntil').exists() || root.child('users').child(auth.uid).child('jailedUntil').val() < now || $roomId === root.child('users').child(auth.uid).child('jailedIn').val()) && (!root.child('config').child('newbieRooms').child($roomId).exists() || root.child('users').child(auth.uid).child('isNew').val() === true || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mentor_senior' || root.child('users').child(auth.uid).child('role').val() === 'mentor')))"
          }
        },
        "messages": {
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('id').val() === auth.uid"
          }
        }
      }
    },

    "reports": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod')",
      "$reportId": {
        ".write": "auth != null && ((!data.exists() && newData.child('reporterUid').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod')"
      }
    },

    "friendRequests": {
      "$toUid": {
        "$fromUid": {
          ".read": "auth != null && (auth.uid === $toUid || auth.uid === $fromUid)",
          ".write": "auth != null && (auth.uid === $fromUid || auth.uid === $toUid)",
          ".validate": "!newData.exists() || (newData.child('fromName').val() != null && newData.child('at').val() != null)"
        }
      }
    },

    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || (auth.uid === $otherUid && (!newData.exists() || root.child('friendRequests').child($otherUid).child($uid).exists())))",
          ".validate": "!newData.exists() || newData.child('name').isString()"
        }
      }
    },

    "staffDirectory": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm')"
      }
    },

    "config": {
      "prisonRooms": {
        ".read": "auth != null",
        "$roomId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev')"
        }
      },
      "newbieRooms": {
        ".read": "auth != null",
        "$roomId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev')"
        }
      }
    },

    "pendingJailReviews": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod')"
    },

    "jailHistory": {
      "$targetUid": {
        ".read": "auth != null && (auth.uid === $targetUid || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod')"
      }
    },

    "jailActionsByJailer": {
      "$jailerUid": {
        ".read": "auth != null && (auth.uid === $jailerUid || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior' || root.child('users').child(auth.uid).child('role').val() === 'mod')"
      }
    },

    "gangs": {
      ".read": "auth != null",
      "$gangId": {
        ".write": "auth != null",
        "official": {
          ".validate": "newData.val() === false || (root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm' || root.child('users').child(auth.uid).child('role').val() === 'mod_senior')"
        }
      }
    },

    "privateMessages": {
      "$convoId": {
        ".read": "auth != null && $convoId.contains(auth.uid)",
        ".write": "auth != null && $convoId.contains(auth.uid)"
      }
    },

    "privateThreads": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$otherUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $otherUid)"
        }
      }
    },

    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'dev_senior' || root.child('users').child(auth.uid).child('role').val() === 'dev' || root.child('users').child(auth.uid).child('role').val() === 'gm')"
      }
    }
  }
}
